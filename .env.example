# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=poly_house

# watch-режим: интервал между прогонами, сек
WATCH_INTERVAL=60

# первый прогон: загружать маркеты, обновлявшиеся за последние N дней
UPDATED_IN_DAYS=30

# rate limiter: RATE_LIMIT_COUNT запросов за RATE_LIMIT_INTERVAL секунд
RATE_LIMIT_INTERVAL=1.0
RATE_LIMIT_COUNT=5

# необязательный фильтр маркетов по тегам (JSON-массив), пусто = без фильтра
# MARKETS_TAG_IDS=[1,2]

# исключить маркеты с этими тегами (фильтр на нашей стороне)
# MARKETS_EXCLUDE_TAG_IDS=[3,4]

# пропускать маркеты, у которых outcomes != ["Yes", "No"]
# MARKETS_YES_NO_ONLY=true

# оставлять только маркеты с neg_risk == значению (null/absent в API = false)
# MARKETS_NEG_RISK=false

# размеры страниц API
MARKETS_PAGE_LIMIT=100
TRADES_PAGE_LIMIT=1000
TRADES_MAX_OFFSET=3000

# REST API
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
