# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=poly_house_dev

# watch-режим: интервал между прогонами, сек
WATCH_INTERVAL=60

# sync-event --watch: интервал между прогонами, сек
SYNC_EVENT_WATCH_INTERVAL=1800

# sync-kline --watch: интервал между прогонами, сек
SYNC_KLINE_WATCH_INTERVAL=60

# sync-holder --watch: интервал между прогонами, сек
SYNC_HOLDER_WATCH_INTERVAL=86400

# первый прогон: загружать events, обновлявшиеся за последние N дней
UPDATED_IN_DAYS=30

# первый прогон sync-home-profile: activity cache за последние N дней (источник: Gateway /data/closed-positions)
ACTIVITY_CACHE_IN_DAYS=365

# sync-profile: считать profile свежим, если synced_at моложе N дней
PROFILE_SYNC_INTERVAL_DAYS=1

# sync-home-profile: считать home profile свежим, если synced_at моложе N часов
HOME_PROFILE_SYNC_INTERVAL_HOURS=6

# необязательный фильтр events по тегам (JSON-массив), пусто = без фильтра
# EVENTS_TAG_IDS=[1,2]

# исключить events с этими тегами (exclude_tag_id в API)
# EVENTS_EXCLUDE_TAG_IDS=[3,4]

# пропускать event, если среди nested markets есть outcomes != ["Yes", "No"]
# MARKETS_YES_NO_ONLY=true

# оставлять только events с neg_risk == значению (null/absent в API = false)
# EVENTS_NEG_RISK=false

# размеры страниц API
# /gamma/events: max limit = 100
EVENTS_PAGE_LIMIT=100
TRADES_PAGE_LIMIT=1000
TRADES_MAX_OFFSET=3000

# sync-holder: лимит Gateway /data/holders (max 500)
HOLDERS_LIMIT=500

# activity: пагинация Gateway /data/activity
ACTIVITY_PAGE_LIMIT=500
ACTIVITY_MAX_OFFSET=3000

# activity cache: пагинация Gateway /data/closed-positions
ACTIVITY_CACHE_PAGE_LIMIT=50
ACTIVITY_CACHE_MAX_OFFSET=100000

# Polymarket Gateway
GATEWAY_URL=http://localhost:8080

# REST API
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
